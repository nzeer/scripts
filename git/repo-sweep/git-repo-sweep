#!/usr/bin/env bash

set -u
set -o pipefail

PROGRAM="${0##*/}"

ROOT="/repos"
MODE="pull"
DRY_RUN=0
RECURSIVE=1
JOBS=1
VERBOSE=0

declare -a REPOS=()
declare -a RESULT_NAMES=()
declare -a RESULT_BRANCHES=()
declare -a RESULT_STATES=()
declare -a RESULT_DETAILS=()

usage() {
    cat <<EOF
Usage:
  $PROGRAM [options] [repo-root]

Update Git repositories beneath a parent directory.

Options:
  -f, --fetch           Fetch remotes only
  -p, --pull            Pull using --ff-only (default)
  -r, --rebase          Pull using --rebase
  -n, --dry-run         Show what would be done without changing repositories
  -j, --jobs N          Parallel jobs for fetch mode (default: 1)
      --no-recursive    Only inspect immediate children of repo-root
  -v, --verbose         Show additional information
  -h, --help            Show this help

Examples:
  $PROGRAM
  $PROGRAM /repos
  $PROGRAM --fetch /repos
  $PROGRAM --fetch --jobs 8 /repos
  $PROGRAM --pull --dry-run ~/src
  $PROGRAM --rebase /opt/projects

Behavior:
  pull:
    Uses 'git pull --ff-only'. Diverged branches fail safely.

  rebase:
    Uses 'git pull --rebase'. Dirty repositories are skipped.

  fetch:
    Runs 'git fetch --all --prune'. Can be parallelized with --jobs.

Exit status:
  0   All repositories completed successfully
  1   One or more repositories failed
  2   Invalid arguments or repo root
EOF
}

log() {
    printf '%s\n' "$*"
}

debug() {
    (( VERBOSE )) && printf '[DEBUG] %s\n' "$*"
}

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 2
}

run_cmd() {
    if (( DRY_RUN )); then
        printf '[DRY-RUN]'
        printf ' %q' "$@"
        printf '\n'
        return 0
    fi

    "$@"
}

repo_name() {
    local repo="$1"
    basename "$repo"
}

repo_branch() {
    local repo="$1"
    git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

repo_is_dirty() {
    local repo="$1"

    [[ -n "$(git -C "$repo" status --porcelain --untracked-files=normal 2>/dev/null)" ]]
}

repo_has_upstream() {
    local repo="$1"

    git -C "$repo" rev-parse \
        --abbrev-ref \
        --symbolic-full-name \
        '@{upstream}' >/dev/null 2>&1
}

repo_upstream() {
    local repo="$1"

    git -C "$repo" rev-parse \
        --abbrev-ref \
        --symbolic-full-name \
        '@{upstream}' 2>/dev/null || true
}

record_result() {
    RESULT_NAMES+=("$1")
    RESULT_BRANCHES+=("$2")
    RESULT_STATES+=("$3")
    RESULT_DETAILS+=("$4")
}

discover_repos() {
    local root="$1"

    REPOS=()

    if (( RECURSIVE )); then
        while IFS= read -r -d '' git_marker; do
            local repo

            if [[ -d "$git_marker" ]]; then
                repo="${git_marker%/.git}"
            else
                repo="$(dirname "$git_marker")"
            fi

            REPOS+=("$repo")
        done < <(
            find "$root" \
                -mindepth 2 \
                \( -type d -o -type f \) \
                -name .git \
                -print0 2>/dev/null
        )
    else
        local dir
        while IFS= read -r -d '' dir; do
            if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                REPOS+=("${dir%/}")
            fi
        done < <(
            find "$root" \
                -mindepth 1 \
                -maxdepth 1 \
                -type d \
                -print0
        )
    fi

    if ((${#REPOS[@]})); then
        mapfile -t REPOS < <(
            printf '%s\n' "${REPOS[@]}" |
                awk '!seen[$0]++' |
                sort
        )
    fi
}

process_repo() {
    local repo="$1"
    local name branch upstream dirty=0

    name="$(repo_name "$repo")"
    branch="$(repo_branch "$repo")"

    printf '\n================================================================\n'
    printf ' Repo:   %s\n' "$repo"

    if [[ -z "$branch" ]]; then
        printf ' Branch: DETACHED\n'
        printf '================================================================\n'
        printf '[SKIP] Detached HEAD\n'
        record_result "$name" "DETACHED" "SKIP" "detached HEAD"
        return 0
    fi

    printf ' Branch: %s\n' "$branch"

    if repo_has_upstream "$repo"; then
        upstream="$(repo_upstream "$repo")"
        printf ' Track:  %s\n' "$upstream"
    else
        upstream=""
        printf ' Track:  none\n'
    fi

    if repo_is_dirty "$repo"; then
        dirty=1
        printf ' Status: dirty\n'
    else
        printf ' Status: clean\n'
    fi

    printf '================================================================\n'

    case "$MODE" in
        fetch)
            if run_cmd git -C "$repo" fetch --all --prune; then
                if (( dirty )); then
                    record_result "$name" "$branch" "DIRTY" "fetched; local changes present"
                else
                    record_result "$name" "$branch" "OK" "fetched"
                fi
                return 0
            else
                record_result "$name" "$branch" "FAILED" "fetch failed"
                return 1
            fi
            ;;

        pull)
            if [[ -z "$upstream" ]]; then
                printf '[SKIP] No upstream configured for %s\n' "$branch"
                record_result "$name" "$branch" "SKIP" "no upstream"
                return 0
            fi

            if run_cmd git -C "$repo" pull --ff-only; then
                if (( dirty )); then
                    record_result "$name" "$branch" "DIRTY" "updated/current; local changes present"
                else
                    record_result "$name" "$branch" "OK" "updated/current"
                fi
                return 0
            else
                record_result "$name" "$branch" "FAILED" "pull --ff-only failed"
                return 1
            fi
            ;;

        rebase)
            if [[ -z "$upstream" ]]; then
                printf '[SKIP] No upstream configured for %s\n' "$branch"
                record_result "$name" "$branch" "SKIP" "no upstream"
                return 0
            fi

            if (( dirty )); then
                printf '[SKIP] Dirty repository; refusing automatic rebase\n'
                record_result "$name" "$branch" "DIRTY" "rebase skipped; local changes present"
                return 0
            fi

            if run_cmd git -C "$repo" pull --rebase; then
                record_result "$name" "$branch" "OK" "rebased/current"
                return 0
            else
                record_result "$name" "$branch" "FAILED" "pull --rebase failed"
                return 1
            fi
            ;;
    esac
}

process_fetch_parallel_worker() {
    local repo="$1"
    local result_dir="$2"
    local idx="$3"

    local name branch dirty=0 state detail rc=0

    name="$(repo_name "$repo")"
    branch="$(repo_branch "$repo")"

    [[ -z "$branch" ]] && branch="DETACHED"

    if repo_is_dirty "$repo"; then
        dirty=1
    fi

    {
        printf '\n================================================================\n'
        printf ' Repo:   %s\n' "$repo"
        printf ' Branch: %s\n' "$branch"
        printf ' Status: %s\n' "$([[ $dirty -eq 1 ]] && echo dirty || echo clean)"
        printf '================================================================\n'

        if (( DRY_RUN )); then
            printf '[DRY-RUN] git -C %q fetch --all --prune\n' "$repo"
            state="$([[ $dirty -eq 1 ]] && echo DIRTY || echo OK)"
            detail="would fetch"
        elif git -C "$repo" fetch --all --prune; then
            state="$([[ $dirty -eq 1 ]] && echo DIRTY || echo OK)"
            detail="fetched"
        else
            state="FAILED"
            detail="fetch failed"
            rc=1
        fi

        printf '%s\t%s\t%s\t%s\n' \
            "$name" "$branch" "$state" "$detail" > "$result_dir/$idx.result"
    } > "$result_dir/$idx.output" 2>&1

    return "$rc"
}

process_fetch_parallel() {
    local result_dir
    result_dir="$(mktemp -d)"
    trap 'rm -rf "$result_dir"' RETURN

    local -a pids=()
    local -a indexes=()
    local running=0
    local idx=0
    local repo pid any_failed=0

    for repo in "${REPOS[@]}"; do
        process_fetch_parallel_worker "$repo" "$result_dir" "$idx" &
        pid=$!

        pids+=("$pid")
        indexes+=("$idx")
        ((running += 1))
        ((idx += 1))

        if (( running >= JOBS )); then
            local i

            for i in "${!pids[@]}"; do
                if ! wait "${pids[$i]}"; then
                    any_failed=1
                fi
            done

            pids=()
            indexes=()
            running=0
        fi
    done

    local i
    for i in "${!pids[@]}"; do
        if ! wait "${pids[$i]}"; then
            any_failed=1
        fi
    done

    local total="${#REPOS[@]}"
    for ((i=0; i<total; i++)); do
        [[ -f "$result_dir/$i.output" ]] && cat "$result_dir/$i.output"

        if [[ -f "$result_dir/$i.result" ]]; then
            local name branch state detail
            IFS=$'\t' read -r name branch state detail < "$result_dir/$i.result"
            record_result "$name" "$branch" "$state" "$detail"
        fi
    done

    return "$any_failed"
}

print_summary() {
    local ok=0 dirty=0 failed=0 skipped=0
    local i

    printf '\n\nSummary\n'
    printf '%-8s %-28s %-18s %s\n' "STATE" "REPOSITORY" "BRANCH" "DETAIL"
    printf '%-8s %-28s %-18s %s\n' "--------" "----------------------------" "------------------" "------------------------------"

    for i in "${!RESULT_NAMES[@]}"; do
        printf '%-8s %-28s %-18s %s\n' \
            "${RESULT_STATES[$i]}" \
            "${RESULT_NAMES[$i]}" \
            "${RESULT_BRANCHES[$i]}" \
            "${RESULT_DETAILS[$i]}"

        case "${RESULT_STATES[$i]}" in
            OK)     ((ok += 1)) ;;
            DIRTY)  ((dirty += 1)) ;;
            FAILED) ((failed += 1)) ;;
            SKIP)   ((skipped += 1)) ;;
        esac
    done

    printf '\n'
    printf 'OK      : %d\n' "$ok"
    printf 'DIRTY   : %d\n' "$dirty"
    printf 'FAILED  : %d\n' "$failed"
    printf 'SKIPPED : %d\n' "$skipped"
    printf 'TOTAL   : %d\n' "${#RESULT_NAMES[@]}"

    (( failed == 0 ))
}

while (($#)); do
    case "$1" in
        -f|--fetch)
            MODE="fetch"
            shift
            ;;
        -p|--pull)
            MODE="pull"
            shift
            ;;
        -r|--rebase)
            MODE="rebase"
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=1
            shift
            ;;
        -j|--jobs)
            (($# >= 2)) || die "--jobs requires a value"
            JOBS="$2"
            [[ "$JOBS" =~ ^[1-9][0-9]*$ ]] || die "--jobs must be a positive integer"
            shift 2
            ;;
        --no-recursive)
            RECURSIVE=0
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            ROOT="$1"
            shift
            (($# == 0)) || die "only one repo root may be specified"
            ;;
    esac
done

command -v git >/dev/null 2>&1 || die "git not found in PATH"
[[ -d "$ROOT" ]] || die "repo root does not exist: $ROOT"

ROOT="$(cd "$ROOT" && pwd -P)"

if (( JOBS > 1 )) && [[ "$MODE" != "fetch" ]]; then
    die "--jobs is supported only with --fetch"
fi

log "Git repository sweep"
log "Root:      $ROOT"
log "Mode:      $MODE"
log "Recursive: $([[ $RECURSIVE -eq 1 ]] && echo yes || echo no)"
log "Dry-run:   $([[ $DRY_RUN -eq 1 ]] && echo yes || echo no)"

if [[ "$MODE" == "fetch" ]]; then
    log "Jobs:      $JOBS"
fi

discover_repos "$ROOT"

if ((${#REPOS[@]} == 0)); then
    log
    log "No Git repositories found."
    exit 0
fi

log "Repos:     ${#REPOS[@]}"

debug "Repositories discovered:"
if (( VERBOSE )); then
    printf '  %s\n' "${REPOS[@]}"
fi

overall_rc=0

if [[ "$MODE" == "fetch" ]] && (( JOBS > 1 )); then
    process_fetch_parallel || overall_rc=1
else
    for repo in "${REPOS[@]}"; do
        process_repo "$repo" || overall_rc=1
    done
fi

print_summary || overall_rc=1

exit "$overall_rc"

